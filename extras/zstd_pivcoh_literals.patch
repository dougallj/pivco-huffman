+typedef int pivcoh_impl_c_not_empty;
+#ifdef ZSTD_PIVCOH_LITERALS
+#define PIVCOH_IMPLEMENTATION
+#include "pivcoh_glue.h"
+__thread uint8_t pvz_escratch[PIVCOH_SCRATCH_SIZE(PVZ_BLOCK)];
+__thread uint8_t pvz_jscratch[PIVCOH_JOINT_SCRATCH_SIZE];
+__thread uint8_t pvz_stage[PIVCOH_ENCODE_BOUND(PVZ_BLOCK)];
+__thread uint8_t pvz_dscratch[PIVCOH_DECODE_SCRATCH_SIZE(PVZ_BLOCK)];
+#endif
