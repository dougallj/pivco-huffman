new file mode 100644
index 0000000..5743af1
--- /dev/null
+++ b/lib/common/pivcoh_glue.h
@@ -0,0 +1,22 @@
+/* pivcoh literals backend for zstd — experiment glue (pivco-huffman repo).
+ * Build with -DZSTD_PIVCOH_LITERALS to replace HUF literals with pivcoh
+ * blocks: compressed literals = [pivcoh lens wire][pivcoh block...],
+ * treeless literals = [pivcoh block...] against the previous table.
+ * NON-STANDARD FRAMES: only this build can decode its own output.
+ * The pivcoh table is smuggled inside the existing HUF entropy regions
+ * (956 B fits both ZSTD_hufCTables_t.CTable and entropy.hufTable), with
+ * a magic word so dictionary-loaded HUF state can never be mistaken
+ * for ours.  Dictionaries and targetCBlockSize are not supported. */
+#ifndef PIVCOH_GLUE_H
+#define PIVCOH_GLUE_H
+#include "pivcoh.h"
+
+#define PVZ_BLOCK 32767
+#define PVZ_MAGIC 0x34435650u   /* "PVC4" */
+
+extern __thread uint8_t pvz_escratch[PIVCOH_SCRATCH_SIZE(PVZ_BLOCK)];
+extern __thread uint8_t pvz_jscratch[PIVCOH_JOINT_SCRATCH_SIZE];
+extern __thread uint8_t pvz_stage[PIVCOH_ENCODE_BOUND(PVZ_BLOCK)];
+extern __thread uint8_t pvz_dscratch[PIVCOH_DECODE_SCRATCH_SIZE(PVZ_BLOCK)];
+
+#endif /* PIVCOH_GLUE_H */
